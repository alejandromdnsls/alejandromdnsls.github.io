---
interface Props {
  id: string;
  label: string;
  hint?: string;
  error?: string;
  required?: boolean;
  optional?: boolean;
  class?: string;
}
const { id, label, hint, error, required, optional, class: className = '' } = Astro.props;
---

<div class={className} data-field>
  <label for={id} class="block text-sm font-medium text-fg">
    {label}
    {required && <span class="font-light text-fg-muted"> (obligatorio)</span>}
    {optional && <span class="font-light text-fg-muted"> (opcional)</span>}
  </label>
  {hint && <p id={`${id}-hint`} class="mt-1 text-sm text-fg-muted">{hint}</p>}
  <div class="mt-2"><slot /></div>
  <p id={`${id}-error`} data-error class:list={['mt-2 items-start gap-2 text-sm text-[var(--color-error)]', error ? 'flex' : 'hidden']}>
    <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="8" cy="8" r="6.25" /><path stroke-linecap="round" d="M8 4.75v4M8 11.25h.01" />
    </svg>
    <span data-error-text>{error}</span>
  </p>
</div>
