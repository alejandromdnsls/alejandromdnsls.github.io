  /* Motion: transform and opacity only, slow and staggered loops. */
  :is(.sf, .sfu) .sf-travel { animation: sf-travel 3s linear infinite; }
  :is(.sf, .sfu) .sf-blink { animation: sf-blink 1.6s steps(1, end) infinite; }
  :is(.sf, .sfu) .sf-wave { animation: sf-wave 2.1s ease-in-out infinite; }
  :is(.sf, .sfu) .sf-refresh { animation: sf-refresh 3.4s ease-in-out infinite; }
  :is(.sf, .sfu) .sf-grow { animation: sf-grow 3.6s ease-in-out infinite alternate; }
  :is(.sf, .sfu) .sf-type { animation: sf-type 3.2s steps(8, end) infinite; }
  :is(.sf, .sfu) .sf-scan { animation: sf-scan 1.8s ease-in-out infinite alternate; }
  :is(.sf, .sfu) .sf-scan-cone { animation: sf-wave 1.8s ease-in-out infinite; }
  :is(.sf, .sfu) .sf-drive-in { animation: sf-drive-in 8s cubic-bezier(0.2, 0, 0, 1) infinite; }
  :is(.sf, .sfu) .sf-pose { animation-duration: 8s; animation-timing-function: linear; animation-iteration-count: infinite; }
  :is(.sf, .sfu) .pose-off { opacity: 0; }
  :is(.sf, .sfu) .sf-tap { animation: sf-tap 4s ease-in-out infinite; }
  :is(.sf, .sfu) .sf-nfc { animation: sf-nfc 4s ease-in-out infinite; }
  :is(.sf, .sfu) .sf-paid { animation: sf-paid 4s ease-in-out infinite; }
  :is(.sf, .sfu) .sf-receipt { animation: sf-receipt 4s ease-in-out infinite; }
  :is(.sf, .sfu) .sf-bob { animation: sf-bob 2.8s ease-in-out infinite alternate; }
  :is(.sf, .sfu) .sf-drift { animation: sf-drift 6s ease-in-out infinite alternate; }
  .sf.is-paused .sf-anim { animation-play-state: paused; }

  @keyframes sf-travel {
    0% { transform: translateY(0); opacity: 0; }
    12%, 88% { opacity: 1; }
    100% { transform: translateY(var(--l)); opacity: 0; }
