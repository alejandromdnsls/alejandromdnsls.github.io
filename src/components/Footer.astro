---
import Container from './Container.astro';
import Watermark from './Watermark.astro';
import { CONTACT, HAS_NON_ESSENTIAL, WHATSAPP_URL } from '../data/site';
import { COMPANY } from '../data/legal';

const year = new Date().getFullYear();
const NAV_LINKS = [
  { label: 'Servicios', href: '/servicios' },
  { label: 'Casos de estudio', href: '/casos' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Contacto', href: '/contacto' },
];
const LEGAL_LINKS = [
  { label: 'Aviso de privacidad', href: '/aviso-de-privacidad' },
  { label: 'Política de cookies', href: '/politica-de-cookies' },
  { label: 'Términos de uso', href: '/terminos' },
];
// Pyramidev's own products (public sites).
const PRODUCTS = [
  { label: 'Ticketax', note: 'Autofacturación para estacionamientos', href: 'https://ticketax.com/' },
  { label: 'Livilinq', note: 'Administración de residenciales', href: 'https://livilinq.com/' },
];
const link = 'text-sm text-[var(--pv-lilac)] transition-colors duration-150 hover:text-white';
---

<footer class="relative overflow-hidden border-t-4 border-navy bg-ink text-white">
  <Watermark on="dark" class="-bottom-28 -right-24 w-[22rem] opacity-[0.08] lg:-bottom-40 lg:-right-28 lg:w-[34rem]" />
  <Container class="relative py-14 lg:py-20">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12">
      <div class="sm:col-span-2 lg:col-span-4">
        <img src="/logo-dark.png" alt="Pyramidev" width="600" height="71" class="h-7 w-auto lg:h-8" />
        <p class="mt-5 max-w-sm text-[var(--pv-lilac)]">
          Software para operaciones críticas: estacionamientos, pagos, control de acceso y sistemas de punta a punta.
        </p>
      </div>

      <nav aria-label="Secciones" class="lg:col-span-2 lg:col-start-6">
        <h2 class="text-xs font-medium uppercase tracking-[0.08em] text-[var(--pv-sky)]">Sitio</h2>
        <ul class="mt-4 space-y-2">
          {NAV_LINKS.map((l) => <li><a class={link} href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="lg:col-span-2">
        <h2 class="text-xs font-medium uppercase tracking-[0.08em] text-[var(--pv-sky)]">Productos</h2>
        <ul class="mt-4 space-y-3">
          {PRODUCTS.map((p) => (
            <li>
              <a class={link} href={p.href} target="_blank" rel="noopener">{p.label}</a>
              <p class="text-sm text-[var(--pv-lilac)]">{p.note}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h2 class="text-xs font-medium uppercase tracking-[0.08em] text-[var(--pv-sky)]">Contacto</h2>
        <ul class="mt-4 space-y-2">
          <li><a class={link} href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          <li><a class={link} href={`tel:${CONTACT.phone.tel}`}>{CONTACT.phone.display}</a></li>
          <li><a class={link} href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp: {CONTACT.whatsapp.display}</a></li>
          <li class="text-sm text-[var(--pv-lilac)]">{CONTACT.location}</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-[var(--pv-ink-line)] pb-16 pt-6 sm:flex-row sm:pb-0 sm:pr-20 sm:items-center sm:justify-between">
      <div class="space-y-1">
        <p class="text-sm text-[var(--pv-lilac)]">© {year} Pyramidev. Todos los derechos reservados.</p>
        {/* TODO(legal): confirm which domicile the site must publish (today without «Interior 302», per the workspace CLAUDE.md). */}
        <p class="text-sm text-[var(--pv-lilac)]">{COMPANY.legalName} · RFC {COMPANY.rfc} · {COMPANY.address}</p>
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {LEGAL_LINKS.map((l) => <li><a class={link} href={l.href}>{l.label}</a></li>)}
        {HAS_NON_ESSENTIAL && (
          <li><a class={link} href="/politica-de-cookies#configurar" data-consent-open>Configurar cookies</a></li>
        )}
      </ul>
    </div>
  </Container>
</footer>
