---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { SERVICES } from '../data/services';
import Watermark from './Watermark.astro';
import { CASE_KIND_LABEL as kindLabel } from '../data/caseKinds';

interface Props {
  entry: CollectionEntry<'cases'>;
}
const { entry } = Astro.props;
const { title, sector, kind, summary, services, stack, images } = entry.data;
const cover = images[0];
const serviceNames = services.map((s) => SERVICES.find((x) => x.slug === s)?.title).filter(Boolean);
---

<article class="relative flex flex-col overflow-hidden rounded-lg border border-line bg-canvas transition-colors duration-200 hover:border-brand">
  {cover && (
    <Picture
      src={cover.src}
      alt=""
      widths={[320, 480, 640]}
      sizes="(min-width: 1024px) 352px, (min-width: 768px) 50vw, 100vw"
      formats={['avif', 'webp']}
      class="aspect-[16/9] w-full border-b border-line object-cover object-top"
      loading="lazy"
    />
  )}
  {!cover && (
    <div class="bg-brand-dark relative aspect-[16/9] w-full overflow-hidden border-b border-line" aria-hidden="true">
      <Watermark on="dark" class="-bottom-16 -right-10 w-[20rem] opacity-[0.22]" />
    </div>
  )}
  <div class="flex flex-1 flex-col p-6">
  <p class="text-xs font-medium uppercase tracking-[0.08em] text-fg-muted">
    {sector}{' · '}{kindLabel[kind]}
  </p>
  <h3 class="mt-3 text-[1.375rem] leading-[1.3]">
    <a href={`/casos/${entry.id}`} class="after:absolute after:inset-0 hover:text-link-base">{title}</a>
  </h3>
  <p class="mt-3 text-fg-muted">{summary}</p>
  {serviceNames.length > 0 && (
    <p class="mt-4 text-sm text-fg-muted">
      <span class="sr-only">Servicios: </span>{serviceNames.join(' · ')}
    </p>
  )}
  {stack.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tecnologías">
      {stack.map((t) => <li class="rounded-sm bg-panel px-2 py-1 text-xs font-medium text-fg">{t}</li>)}
    </ul>
  )}
  </div>
</article>
