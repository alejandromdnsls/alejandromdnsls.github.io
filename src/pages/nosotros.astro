---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';

const PILLARS = [
  {
    title: 'Innovación',
    text: 'Usamos herramientas probadas y las explicamos sin tecnicismos. Innovar, para nosotros, es encontrar la forma más simple de resolver un problema que ya existe en tu operación.',
  },
  {
    title: 'Eficiencia',
    text: 'Cada pantalla y cada proceso se revisan contra una pregunta: ¿esto le ahorra pasos a quien lo usa? Si no, lo quitamos o lo rehacemos.',
  },
  {
    title: 'Automatización',
    text: 'Pasamos a sistema lo repetitivo: cobros, conciliaciones, notificaciones y reportes. Tu equipo se queda con las decisiones y las excepciones.',
  },
];

---

<BaseLayout
  title="Nosotros | Pyramidev"
  description="Somos un equipo mexicano con más de 10 años desarrollando software para operaciones críticas: aeropuertos en México, gobierno, estacionamientos e industria."
>
  <Header slot="header" />

  <PageHeader
    eyebrow="Nosotros"
    title="Un equipo pequeño que construye sistemas grandes"
    lead="Pyramidev es una empresa mexicana de desarrollo de software con sede en CDMX. Nos especializamos en sistemas donde la operación no puede detenerse."
  />

  <Section size="lg">
    <div class="grid gap-10 lg:grid-cols-12">
      <h2 class="text-headline lg:col-span-4">Quiénes somos</h2>
      <div class="space-y-4 text-lg text-fg-muted lg:col-span-8">
        <p>Somos un equipo con más de 10 años desarrollando software. Trabajamos con menos de 20 clientes, pero en proyectos grandes: aeropuertos en México y gobierno, principalmente, además de estacionamientos e industria.</p>
        <p>Nos enfocamos en software para operaciones críticas: estacionamientos, pagos, control de acceso y sistemas de operación de punta a punta. También desarrollamos nuestros propios productos, como Ticketax, una plataforma de autofacturación para estacionamientos, y Livilinq, una plataforma para comunidades residenciales.</p>
      </div>
    </div>
  </Section>

  <Section tone="surface">
    <div class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.08em] text-fg-muted">Principios</p>
      <h2 class="mt-3 text-headline">Innovación, eficiencia y automatización</h2>
    </div>
    <ul class="mt-12 grid gap-8 md:grid-cols-3">
      {PILLARS.map((p) => (
        <li class="border-t border-line-strong pt-4">
          <h3 class="text-[1.375rem] leading-[1.3]">{p.title}</h3>
          <p class="mt-3 text-fg-muted">{p.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section size="lg">
    <div class="grid gap-10 lg:grid-cols-12">
      <h2 class="text-headline lg:col-span-4">Confidencialidad</h2>
      <div class="space-y-4 text-lg text-fg-muted lg:col-span-8">
        <p>Por acuerdos de confidencialidad no publicamos el nombre de todos nuestros clientes. En esos casos tampoco mostramos capturas de sus sistemas.</p>
        <p>Lo que sí hacemos es describir los problemas y las soluciones con detalle técnico suficiente para que evalúes si podemos ayudarte. Puedes verlo en los <a href="/casos" class="text-link-base underline underline-offset-4 hover:text-link-hover">casos de estudio</a>.</p>
      </div>
    </div>
  </Section>

  <CtaBand />

  <Footer slot="footer" />
</BaseLayout>
