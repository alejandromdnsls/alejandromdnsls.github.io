---
import { render } from 'astro:content';
import { getPublishedCases, sortCases } from '../../lib/cases';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import CaseFigures from '../../components/CaseFigures.astro';
import Section from '../../components/Section.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES } from '../../data/services';
import { CASE_KIND_LABEL as kindLabel } from '../../data/caseKinds';

export async function getStaticPaths() {
  const cases = await getPublishedCases();
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, sector, kind, summary, seoTitle, seoDescription, services, stack, url, images } = entry.data;
const related = SERVICES.filter((s) => services.includes(s.slug));
// Next case in the same order as the case list, wrapping around.
const ordered = sortCases(await getPublishedCases());
const next = ordered[(ordered.findIndex((c) => c.id === entry.id) + 1) % ordered.length];

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: 'Inicio', path: '/' },
    { name: 'Casos de estudio', path: '/casos/' },
    { name: title, path: `/casos/${entry.id}/` },
  ].map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: new URL(item.path, Astro.site).href,
  })),
};
---

<BaseLayout title={seoTitle ?? `${title} | Pyramidev`} description={seoDescription ?? summary} structuredData={[breadcrumb]}>
  <Header slot="header" overDark />

  <PageHeader
    compact
    back={{ href: '/casos', label: 'Casos de estudio' }}
    eyebrow={`${sector} · ${kindLabel[kind]}`}
    title={title}
    lead={summary}
  />

  <Section size="xl">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="space-y-12 lg:col-span-8">
        <CaseFigures images={images} url={url} />
        <article class="case-body">
          <Content />
        </article>
      </div>
      <aside class="lg:sticky lg:top-28 lg:col-span-4 lg:self-start" aria-label="Datos del proyecto">
        <dl class="space-y-6 border-t border-line-strong pt-4">
          <div>
            <dt class="text-xs font-medium uppercase tracking-[0.08em] text-fg-muted">Sector</dt>
            <dd class="mt-1">{sector}</dd>
          </div>
          {url && (
            <div>
              <dt class="text-xs font-medium uppercase tracking-[0.08em] text-fg-muted">Sitio</dt>
              <dd class="mt-1">
                <a href={url} target="_blank" rel="noopener" class="text-link-base underline underline-offset-4 hover:text-link-hover">{new URL(url).hostname.replace(/^www\./, '')}</a>
              </dd>
            </div>
          )}
          <div>
            <dt class="text-xs font-medium uppercase tracking-[0.08em] text-fg-muted">Servicios</dt>
            <dd class="mt-1">
              <ul class="space-y-1">
                {related.map((s) => <li><a href={`/servicios#${s.slug}`} class="text-link-base underline underline-offset-4 hover:text-link-hover">{s.title}</a></li>)}
              </ul>
            </dd>
          </div>
          {stack.length > 0 && (
            <div>
              <dt class="text-xs font-medium uppercase tracking-[0.08em] text-fg-muted">Tecnologías</dt>
              <dd class="mt-2">
                <ul class="flex flex-wrap gap-2">
                  {stack.map((t) => <li class="rounded-sm bg-panel px-2 py-1 text-xs font-medium text-fg">{t}</li>)}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      </aside>
    </div>
  </Section>

  {next && next.id !== entry.id && (
    <nav aria-label="Siguiente caso" class="border-t border-line bg-panel">
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <a href={`/casos/${next.id}`} class="group flex min-h-11 flex-col gap-1 py-10 sm:flex-row sm:items-center sm:justify-between">
          <span class="text-xs font-medium uppercase tracking-[0.08em] text-fg-muted">Siguiente caso</span>
          <span class="inline-flex items-center gap-3 text-[1.375rem] leading-[1.3] text-fg group-hover:text-link-base">
            {next.data.title}
            <svg class="size-5 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 10h12m-5-5 5 5-5 5" /></svg>
          </span>
        </a>
      </div>
    </nav>
  )}

  <CtaBand />

  <Footer slot="footer" />
</BaseLayout>
