---
import { getPublishedCases, sortCases } from '../../lib/cases';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import PageHeader from '../../components/PageHeader.astro';
import CaseCard from '../../components/CaseCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { OTHER_PROJECTS } from '../../data/projects';

const cases = sortCases(await getPublishedCases());
---

<BaseLayout
  title="Casos de estudio | Pyramidev"
  description="Proyectos de software para estacionamientos, aeropuertos, industria y servicios. Por confidencialidad, los clientes se describen sin nombre."
>
  <Header slot="header" />

  <PageHeader
    eyebrow="Casos de estudio"
    title="Lo que hemos construido"
    lead="Por acuerdos de confidencialidad no publicamos el nombre de todos nuestros clientes. Cuando el cliente no es público, describimos el problema y la solución sin identificarlo."
  />

  <Section>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {cases.map((entry) => <CaseCard entry={entry} />)}
    </div>
  </Section>

  <Section tone="surface" id="otros-proyectos">
    <div class="max-w-2xl">
      <h2 class="text-headline">Otros proyectos</h2>
      <p class="mt-4 text-lg text-fg-muted">Trabajos anteriores que ya eran públicos en nuestro sitio.</p>
    </div>
    <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {OTHER_PROJECTS.map((p) => (
        <li class="overflow-hidden rounded-lg border border-line bg-canvas">
          <Image
            src={p.image}
            alt={p.alt}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 352px, (min-width: 768px) 50vw, 100vw"
            format="webp"
            class="aspect-[4/3] w-full border-b border-line object-cover"
            loading="lazy"
          />
          <div class="p-6">
            <h3 class="text-[1.375rem] leading-[1.3]">{p.title}</h3>
            <p class="mt-3 text-fg-muted">{p.description}</p>
            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tecnologías">
              {p.stack.map((t) => <li class="rounded-sm bg-panel px-2 py-1 text-xs font-medium text-fg">{t}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <CtaBand />

  <Footer slot="footer" />
</BaseLayout>
