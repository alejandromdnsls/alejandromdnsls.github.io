---
import { getPublishedCases } from '../lib/cases';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { SERVICES } from '../data/services';

const cases = await getPublishedCases();
const caseById = new Map(cases.map((c) => [c.id, c]));
---

<BaseLayout
  title="Servicios | Pyramidev"
  description="Sistemas para estacionamientos, integración de pagos y facturación CFDI 4.0, quioscos y control de acceso, gestión de reportes y sistemas de operación de punta a punta."
>
  <Header slot="header" />

  <PageHeader
    eyebrow="Servicios"
    title="Software a la medida para operaciones críticas"
    lead="Desarrollamos software a la medida y nos especializamos en operaciones donde un error cuesta dinero o detiene el negocio: cobro, acceso, conciliación y reportes."
  />

  {SERVICES.map((s, i) => (
    <Section id={s.slug} tone={i % 2 === 0 ? 'default' : 'surface'} size="xl">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="text-[3rem] leading-none tracking-[-0.03em] text-brand" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h2 class="text-headline mt-4">{s.title}</h2>
          <p class="mt-5 text-lg text-fg-muted">{s.description}</p>
        </div>
        <div class="lg:col-span-7">
          <h3 class="text-xs font-medium uppercase tracking-[0.08em] text-fg-muted">Componentes típicos</h3>
          <ul class="mt-4 divide-y divide-line border-y border-line">
            {s.components.map((c) => <li class="py-3">{c}</li>)}
          </ul>
          <h3 class="mt-8 text-xs font-medium uppercase tracking-[0.08em] text-fg-muted">Casos relacionados</h3>
          <ul class="mt-3 space-y-2">
            {s.cases.map((id) => {
              const c = caseById.get(id);
              return c ? (
                <li>
                  <a href={`/casos/${c.id}`} class="text-link-base underline underline-offset-4 hover:text-link-hover">{c.data.title}</a>
                </li>
              ) : null;
            })}
          </ul>
        </div>
      </div>
    </Section>
  ))}

  <Section size="lg">
    <div class="max-w-2xl">
      <h2 class="text-headline">Cómo nos apoyamos en nube y diseño</h2>
      <p class="mt-4 text-lg text-fg-muted">
        No los vendemos como servicios aparte: son parte de cómo trabajamos. Desplegamos en la nube con procesos repetibles y diseñamos las pantallas pensando en quien las usa todos los días, sea cajero, vigilante o cliente final.
      </p>
    </div>
  </Section>

  <CtaBand />

  <Footer slot="footer" />
</BaseLayout>
